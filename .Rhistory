vesselclause = paste0("\n", ifelse(is.null(vessellist),
"--", ""), "AND vessel.label1 IN ('", paste(vessellist,
collapse = "','"), "')")
oceanclause = paste0("\n", ifelse(is.null(ocean), "--",
""), "AND ocean.label1 IN ('", paste(ocean, collapse = "','"),
"')")
yearclause = paste0("\n", ifelse(is.null(years), "--", ""),
"AND extract(year from route.date) IN (", paste(years,
collapse = ","), ")")
programclause = paste0("\n", ifelse(is.null(programlist),
"--", ""), "AND program.label3 IN ('", paste(programlist,
collapse = "','"), "')")
querytext <- paste("SELECT \n   vessel.label1 as vesname, \n  ocean.label1 as ocean, \n  program.label3 as program, \n  trip.enddate as trip_enddate, \n  route.date, \n  activity.longitude, \n  activity.latitude, \n  activity.time, \n  catch.catchweight, \n  species.faocode, \n  schooltype.label3 as schooltype\nFROM \n  common.ocean, \n  ps_common.program, \n  ps_observation.set, \n  ps_observation.activity, \n  ps_observation.route, \n  ps_common.trip, \n  common.vessel, \n  ps_observation.catch,\n  common.species,\n  ps_common.schooltype\nWHERE \n  activity.topiaid = set.activity AND\n  activity.route = route.topiaid AND\n  route.trip = trip.topiaid AND\n  trip.ocean = ocean.topiaid AND\n  trip.observationsprogram = program.topiaid AND\n  trip.vessel = vessel.topiaid AND\n  catch.set = set.topiaid AND\n  catch.species = species.topiaid AND\n  set.schooltype = schooltype.topiaid",
vesselclause, oceanclause, yearclause, programclause,
";")
print("Ejecutando query")
cat(querytext)
dbDisconnect(con)
Sys.getenv('Observe_pass')
querytext="SELECT
vessel.label1 as vesname,
ocean.label1 as ocean,
program.label3 as program,
trip.enddate as trip_enddate,
route.date,
activity.time,
activity.longitude,
activity.latitude,
activity.time,
catch.catchweight,
species.faocode,
schooltype.label3 as schooltype
FROM
common.ocean,
ps_common.program,
ps_observation.set,
ps_observation.activity,
ps_observation.route,
ps_common.trip,
common.vessel,
ps_observation.catch,
common.species,
ps_common.schooltype
WHERE
activity.topiaid = set.activity AND
activity.route = route.topiaid AND
route.trip = trip.topiaid AND
trip.ocean = ocean.topiaid AND
trip.observationsprogram = program.topiaid AND
trip.vessel = vessel.topiaid AND
catch.set = set.topiaid AND
catch.species = species.topiaid AND
set.schooltype = schooltype.topiaid
--AND vessel.label1 IN ('')
AND ocean.label1 IN ('Atlantic')
--AND extract(year from route.date) IN ()
--AND program.label3 IN ('') ;"
con = observe_connect()
res = dbGetQuery(con, querytext)
dbDisconnect(con)
head(res)
rm(res)
res=observe_catch(ocean='Atlantic')
head(res)
saveRDS(res,'observecatch.rds')
